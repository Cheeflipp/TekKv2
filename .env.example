# Miljøvariabler for TekK
# Kopier denne fil til .env.local og udfyld værdierne

# Email Integration (Resend)
# Opret en gratis konto på resend.com og indsæt din API nøgle her
RESEND_API_KEY=
# Modtager email for alle henvendelser og bookinger (din kontaktmail)
ADMIN_EMAIL=cwk@tekk.dk
# Afsender email (Når du har verificeret dit domæne hos Resend, f.eks. cwk@tekk.dk eller noreply@tekk.dk)
EMAIL_FROM=cwk@tekk.dk

# Google Maps API Key (til adresse autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
